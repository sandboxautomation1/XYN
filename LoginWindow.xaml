<Window x:Class="GoldDesk.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gold Desk · Вход"
        Width="520"
        Height="620"
        MinWidth="440"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Width="390" HorizontalAlignment="Center">
            <TextBlock Text="XAU / USD" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="Gold Desk" Foreground="{StaticResource GoldBrush}" FontSize="38" FontFamily="Georgia" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="26">
                <StackPanel>
                    <TextBlock x:Name="AuthTitle" Text="Вход" FontSize="26" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AuthSubtitle" Text="Влезте, за да използвате пазарния анализ." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Имейл" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="EmailBox"/>
                    <TextBlock Text="Парола" Foreground="{StaticResource MutedBrush}"/>
                    <PasswordBox x:Name="PasswordBox" Background="#26231E" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10,8" Margin="0,4,0,12"/>
                    <Button x:Name="AuthButton" Content="Вход" Click="AuthButton_Click"/>
                    <Button x:Name="ToggleAuthButton" Content="Нямате акаунт? Регистрация" Click="ToggleAuth_Click" Background="Transparent" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="AuthStatus" Foreground="{StaticResource BearBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
