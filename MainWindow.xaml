<Window
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:GoldDesk.Desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" 
    x:Class="GoldDesk.Desktop.MainWindow"
    Title="Gold Desk · XAU/USD" Width="1440" Height="960" MinWidth="1120" MinHeight="760"
    WindowStartupLocation="CenterScreen" 
    WindowState="Maximized" Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="DASHBOARD" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="XAU/USD" Foreground="{StaticResource GoldBrush}" FontSize="30" FontFamily="Georgia"/>
                <TextBlock x:Name="LastUpdatedText" Text="Последно обновяване · market data" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="MT5 SYMBOL" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SymbolInputBox" Width="80" TextAlignment="Center" Margin="0,4,6,4" Text="XAUUSD.p" ToolTip="Въведете MT5 символ, например XAUUSD.p"/>
                        <Button x:Name="ApplySymbolButton" Content="Приложи" Click="ApplySymbol_Click" Margin="0,4,0,4"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,15,20,0" Height="19">
                    <TextBlock x:Name="PriceMeta" Text="Зареждане…" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Content="Обнови Анализа" Click="Refresh_Click" Height="33.96" Margin="0,4,8,5" VerticalAlignment="Bottom"/>
                <Button x:Name="ChangeSourceButton" Content="Стартирай Bridge" Click="StartMt5Bridge_Click" Height="33.96" VerticalAlignment="Bottom" Margin="0,4,8,5"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="LIVE PRICE" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="CloseText" Text="--" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="XAU/USD" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="OPEN" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="OpenText" Text="--" Foreground="{StaticResource GoldBrush}"  FontFamily="Consolas" FontSize="22"/>
                    <TextBlock Text="текуща сесия" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="HIGH" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="HighText" Text="--" Foreground="{StaticResource BullBrush}" FontFamily="Consolas" FontSize="22"/>
                    <TextBlock Text="OHLC high" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="LOW" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="LowText" Text="--" Foreground="{StaticResource BearBrush}" FontFamily="Consolas" FontSize="22"/>
                    <TextBlock Text="OHLC low" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="LOCAL SIGNAL" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentSignalText" Text="ИЗЧАКАЙ" Foreground="{StaticResource HoldBrush}" FontFamily="Consolas" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="SignalMeta" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="PRICE PREDICTION" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#25231F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="SHORT-TERM " Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="14" TextAlignment="Center" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="Следващите 30 минути" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,8"/>
                                <TextBlock x:Name="ShortTermRangeText" Text="--" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="ShortTermAverageText" Text="Средно: --" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                <TextBlock x:Name="ShortTermChangeText" Text="Промяна: --" Foreground="{StaticResource BullBrush}" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#25231F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="LONG-TERM" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="14" TextAlignment="Center" FontWeight="Bold"/>
                                </DockPanel>
                                <TextBlock Text="Следващият 1 час" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,8"/>
                                <TextBlock x:Name="LongTermRangeText" Text="--" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="LongTermAverageText" Text="Средно: --" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                <TextBlock x:Name="LongTermChangeText" Text="Промяна: --" Foreground="{StaticResource BullBrush}" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#25231F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="4 HOURS" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="14" TextAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="Следващите 4 часа" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,8"/>
                                <TextBlock x:Name="FourHourRangeText" Text="--" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="FourHourAverageText" Text="Средно: --" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                <TextBlock x:Name="FourHourChangeText" Text="Промяна: --" Foreground="{StaticResource BullBrush}" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#25231F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="PRICE RANGES" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="14" TextAlignment="Center"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="30 MIN" Foreground="{StaticResource GoldBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="DailyRangeText" Text="--" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="16"/>
                            <TextBlock Text="следващите 30 минути" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            <TextBlock x:Name="DailyAverageText" Text="Средно: --" Foreground="{StaticResource TextBrush}" FontSize="10" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="1 HOUR" Foreground="{StaticResource GoldBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="WeeklyRangeText" Text="--" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="16"/>
                            <TextBlock Text="следващият 1 час" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WeeklyAverageText" Text="Средно: --" Foreground="{StaticResource TextBrush}" FontSize="10" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#25231F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="TECHNICAL INDICATORS" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="14" TextAlignment="Center"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SMA (20)" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            <TextBlock x:Name="SmaText" Text="--" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="14"/>
                            <TextBlock Text="RSI (14)" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                            <TextBlock x:Name="RsiText" Text="--" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="MACD" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            <TextBlock x:Name="MacdText" Text="--" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="14"/>
                            <TextBlock Text="BOLLINGER (20, 2)" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                            <TextBlock x:Name="BollingerText" Text="--" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="CONFIDENCE" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="22" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Технически Анализ" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConfidenceText" Text="--" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="22" HorizontalAlignment="Center"/>
                  
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Padding="14" >
                <TabControl SelectionChanged="TabControl_SelectionChanged" Margin="0,-15,0,-15">
                    <TabItem Header="Графика" Foreground="Black">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="XAU/USD · OHLC CANDLES" Style="{StaticResource CardLabelStyle}"/>
                                    <TextBlock x:Name="ChartMetaText" Text="Зареждане на пазарните данни…" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Период" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="TimeframeBox" Foreground="Black" Width="78" SelectionChanged="TimeframeBox_SelectionChanged">
                                        <ComboBoxItem Content="M1"/>
                                        <ComboBoxItem Content="M5"/>
                                        <ComboBoxItem Content="M15"/>
                                        <ComboBoxItem Content="M30" IsSelected="True"/>
                                        <ComboBoxItem Content="H1"/>
                                        <ComboBoxItem Content="H4"/>
                                    </ComboBox>
                                    <TextBlock Text="зелено · ръст    червено · спад" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="10,0,0,0">
                                <local:MarketChart x:Name="PriceChart"/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Брифинг" Foreground="Black" >
                        <ScrollViewer Padding="4">
                            <TextBlock x:Name="BriefingText" TextWrapping="Wrap" FontSize="14" LineHeight="24" Background="#FF302D26" Foreground="{StaticResource GoldBrush}"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Новини" Foreground="Black">
                        <ListBox x:Name="NewsList" BorderThickness="0" Background="#FF302D26" Foreground="{StaticResource GoldBrush}"/>
                    </TabItem>
                    <TabItem Header="Анализ" Foreground="Black">
                        <StackPanel Margin="8">
                            <TextBlock Text="Поставете линк към статия или текст на новина…" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="ManualBox" AcceptsReturn="True" Height="150" TextWrapping="Wrap"/>
                            <Button Content="Анализирай" Click="Manual_Click" Width="130" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Сигнал" Foreground="Black">
                        <ScrollViewer Padding="4" Margin="10,0,15,0" CanContentScroll="True">
                            <StackPanel Margin="8">
                                <TextBlock Text="TRADERSVIEW · GOLD SIGNAL" Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock Text="Изберете timeframe и заявете актуален сигнал за златото." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="130" Margin="0,0,10,0">
                                        <TextBlock Text="Timeframe" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <ComboBox x:Name="SignalTimeframeBox" Foreground="Black" SelectedIndex="2">
                                            <ComboBoxItem Content="5m"/>
                                            <ComboBoxItem Content="15m"/>
                                            <ComboBoxItem Content="1h"/>
                                            <ComboBoxItem Content="1d"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Button x:Name="AnalyzeSignalButton" Content="Анализирай" Click="AnalyzeSignal_Click" Width="130" Height="36" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock x:Name="SignalRequestText" Text="Готово за заявка" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="SIGNAL" Style="{StaticResource CardLabelStyle}"/>
                                            <TextBlock x:Name="SignalActionText" Text="--" Foreground="{StaticResource GoldBrush}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="CONFIDENCE" Style="{StaticResource CardLabelStyle}"/>
                                            <TextBlock x:Name="SignalTotalConfidenceText" Text="--" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="18"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="ENTRY" Style="{StaticResource CardLabelStyle}"/>
                                            <TextBlock x:Name="SignalEntryText" Text="--" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="16"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="STOP LOSS" Style="{StaticResource CardLabelStyle}"/>
                                            <TextBlock x:Name="SignalStopLossText" Text="--" Foreground="{StaticResource BearBrush}" FontFamily="Consolas" FontSize="16"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="TAKE PROFIT" Style="{StaticResource CardLabelStyle}"/>
                                            <TextBlock x:Name="SignalTakeProfitText" Text="--" Foreground="{StaticResource BullBrush}" FontFamily="Consolas" FontSize="16"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBox x:Name="ConfidenceComponent_1" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,8,0,4"/>
                                <TextBox x:Name="ConfidenceComponent_2" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,4"/>
                                <TextBox x:Name="ConfidenceComponent_3" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,4"/>
                                <TextBlock Text="Бичи (Bullish) Фактори" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="20" Foreground="Black" Margin="0,12,0,4"/>
                                <TextBox x:Name="BullishFactor_1" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,4"/>
                                <TextBox x:Name="BullishFactor_2" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,4"/>
                                <TextBox x:Name="BullishFactor_3" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/>
                                <TextBlock Text="Мечи (Bearish) Фактори" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="20" Foreground="Black" Margin="0,12,0,4"/>
                                <TextBox x:Name="BearishFactor_1" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,4"/>
                                <TextBox x:Name="BearishFactor_2" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,4"/>
                                <TextBox x:Name="BearishFactor_3" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/>
                                <TextBlock Text="Risk Factors" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="20" Foreground="Black" Margin="0,12,0,4"/>
                                <TextBox x:Name="RiskFactor_1" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,4"/>
                                <TextBox x:Name="RiskFactor_2" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,4"/>
                                <TextBox x:Name="RiskFactor_3" Text="--" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/>

                                <TextBlock Text="Trade Levels" Style="{StaticResource CardLabelStyle}" FontFamily="Consolas" FontSize="20" Foreground="Black" Margin="0,12,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="entry" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <TextBox x:Name="SignalTradeEntryText" Text="--" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                        <TextBlock Text="target" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <TextBox x:Name="SignalTradeTargetText" Text="--" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                        <TextBlock Text="stop_loss" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <TextBox x:Name="SignalTradeStopLossText" Text="--" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                        <TextBlock Text="risk_reward_ratio" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        <TextBox x:Name="SignalRiskRewardRatioText" Text="--" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="TradersUnionTab" Header="TU индикатори" Foreground="Black">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <StackPanel Margin="8">
                                <TextBlock Text="TRADERS UNION · QUOTE INDICATORS" Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock Text="Заявка към quotes.tradersunion.com за всеки индикатор в отделно поле." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="LoadTradersUnionButton" Content="Зареди индикаторите" Click="LoadTradersUnion_Click" DockPanel.Dock="Right" Width="170"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Symbol ID" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TradersUnionSymbolBox" Text="775" Width="100" Margin="0,4,12,8"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="TradersUnionRequestText" Text="Готово за заявка" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="TradersUnionIndicatorsPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="TradersUnionTechnicalTab" Header="TU технически анализ" Foreground="Black">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <StackPanel Margin="8">
                                <TextBlock Text="TRADERS UNION · DETAILED TECHNICAL ANALYSIS" Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock Text="Подробна техническа информация от endpoint-а за избрания symbol." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Symbol ID" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TradersUnionTechnicalSymbolBox" Text="775" Width="100" Height="40" Margin="0,4,12,8"/>
                                        <Button x:Name="LoadTradersUnionTechnicalButton" Content="Зареди анализа" Click="LoadTradersUnionTechnical_Click" DockPanel.Dock="Left" Width="150"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="TradersUnionTechnicalRequestText" Text="Готово за заявка" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="TradersUnionTechnicalIndicatorsPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="SourcesTab" Header="Източници" Foreground="Black">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <TextBlock Text="Пазарни данни" FontWeight="SemiBold"/>
                                <TextBlock Text="Twelve Data е основният динамичен източник за XAU/USD. MT5 остава наличен като алтернативен локален източник." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
                                <ComboBox x:Name="ProviderBox" Foreground="Black">
                                    <ComboBoxItem Content="Twelve Data · XAU/USD"/>
                                    <ComboBoxItem Content="MT5 bridge"/>
                                </ComboBox>
                                <TextBlock Text="Symbol (Twelve Data: XAU/USD; MT5: XAUUSD.p)" Margin="0,8,0,0"/>
                                <TextBox x:Name="SymbolBox" Text="XAU/USD"/>
                                <TextBlock Text="Twelve Data API key" Margin="0,8,0,0"/>
                                <PasswordBox x:Name="TwelveDataKeyBox"/>
                                <TextBlock Text="Свещи за API заявката" Margin="0,8,0,0"/>
                                <ComboBox x:Name="IntervalBox" Foreground="Black">
                                    <ComboBoxItem Content="1min"/>
                                    <ComboBoxItem Content="5min" IsSelected="True"/>
                                    <ComboBoxItem Content="15min"/>
                                    <ComboBoxItem Content="30min"/>
                                    <ComboBoxItem Content="1h"/>
                                </ComboBox>
                                <TextBox x:Name="PriceUrlBox" Visibility="Collapsed"/>
                                <TextBlock Text="RSS feeds (one per line)" Margin="0,8,0,0"/>
                                <TextBox x:Name="FeedsBox" AcceptsReturn="True" Height="90"/>
                                <CheckBox x:Name="DefaultNewsBox" Content="Зареждай автоматично Google News новини" IsChecked="True"/>
                                <Button Content="Запази и приложи" Click="SaveSources_Click" Width="180" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="GeneratedSignalsTab" Header="Сигнали" Foreground="Black" FontFamily="Consolas" FontWeight="Bold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16" MaxWidth="1000" HorizontalAlignment="Left">
                                <TextBlock Text="СИГНАЛИ · TWELVE DATA" Style="{StaticResource CardLabelStyle}"/>
                                <TextBlock Text="Сигналът се изчислява локално от OHLC свещите на Twelve Data и техническите индикатори. Обновете данните преди да използвате нивата." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Width="150" Margin="0,0,10,0">
                                        <TextBlock Text="Символ" Foreground="{StaticResource MutedBrush}" FontSize="11" Width="437"/>
                                        <TextBox x:Name="SignalSymbolBox" Text="XAUUSD" ToolTip="Например XAUUSD или XAU/USD" VerticalAlignment="Top"/>
                                    </StackPanel>
                                    <Button x:Name="GenerateMarketSignalButton" Content="Обнови данните и генерирай сигнал" Click="GenerateMarketSignal_Click" Width="280" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBlock x:Name="GeneratedSignalStatusText" Text="Няма генериран сигнал." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,10" TextWrapping="Wrap"/>
                                
                                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,12">
                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,6,0">
                                        <StackPanel><TextBlock Text="ПОСОКА" Style="{StaticResource CardLabelStyle}"/>
                                            <TextBlock x:Name="GeneratedSignalActionText" Text="--" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="ENTRY" Style="{StaticResource CardLabelStyle}"/><TextBlock x:Name="GeneratedSignalEntryText" Text="--" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="STOP-LOSS" Style="{StaticResource CardLabelStyle}"/><TextBlock x:Name="GeneratedSignalStopText" Text="--" Foreground="{StaticResource BearBrush}" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
                                    <Border Style="{StaticResource DashboardCardStyle}"><StackPanel><TextBlock Text="TAKE-PROFIT" Style="{StaticResource CardLabelStyle}"/><TextBlock x:Name="GeneratedSignalTargetText" Text="--" Foreground="{StaticResource BullBrush}" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
                                </UniformGrid>
                                
                                <Border Style="{StaticResource DashboardCardStyle}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Методика" Style="{StaticResource CardLabelStyle}"/>
                                        <TextBlock x:Name="GeneratedSignalDetailsText" Text="Посока по SMA20, MACD и RSI14; stop-loss на 1.5 ATR, take-profit на 2 ATR. При липса на достатъчно данни сигналът остава изчакващ." TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource LevelCardLabelStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
